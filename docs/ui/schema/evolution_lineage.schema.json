{
  "$defs": {
    "LineageNode": {
      "properties": {
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "cycle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cycle Id"
        },
        "origin": {
          "enum": [
            "seed",
            "gepa",
            "topology",
            "twin",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "badges": {
          "items": {
            "type": "string"
          },
          "title": "Badges",
          "type": "array"
        },
        "twins": {
          "items": {
            "type": "string"
          },
          "title": "Twins",
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "promoted",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "new_expert": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "New Expert"
        },
        "r37_regression": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "R37 Regression"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "version_id",
        "name",
        "parent_id",
        "cycle_id",
        "origin",
        "created_at",
        "badges",
        "twins",
        "decision",
        "label",
        "new_expert",
        "r37_regression"
      ],
      "title": "LineageNode",
      "type": "object"
    },
    "NodeMetric": {
      "properties": {
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "noise": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Noise"
        },
        "parent_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Mean"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "beyond_noise": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Beyond Noise"
        }
      },
      "required": [
        "mean",
        "noise",
        "parent_mean",
        "delta",
        "beyond_noise"
      ],
      "title": "NodeMetric",
      "type": "object"
    },
    "NodeScore": {
      "properties": {
        "split": {
          "enum": [
            "train",
            "val"
          ],
          "title": "Split",
          "type": "string"
        },
        "judge_version": {
          "title": "Judge Version",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/NodeMetric"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "split",
        "judge_version",
        "metrics"
      ],
      "title": "NodeScore",
      "type": "object"
    }
  },
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/LineageNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "publish_summary": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Publish Summary"
    }
  },
  "required": [
    "nodes",
    "publish_summary"
  ],
  "title": "Lineage",
  "type": "object"
}
