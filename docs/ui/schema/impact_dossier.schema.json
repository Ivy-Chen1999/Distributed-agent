{
  "$defs": {
    "CostCoverage": {
      "properties": {
        "relevant": {
          "default": 0,
          "title": "Relevant",
          "type": "integer"
        },
        "estimated": {
          "default": 0,
          "title": "Estimated",
          "type": "integer"
        },
        "not_costed": {
          "default": 0,
          "title": "Not Costed",
          "type": "integer"
        },
        "not_estimated": {
          "default": 0,
          "title": "Not Estimated",
          "type": "integer"
        },
        "invalid_dropped": {
          "default": 0,
          "title": "Invalid Dropped",
          "type": "integer"
        },
        "not_covered_keys": {
          "items": {
            "type": "string"
          },
          "title": "Not Covered Keys",
          "type": "array"
        },
        "payers_by_basis": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Payers By Basis",
          "type": "object"
        }
      },
      "title": "CostCoverage",
      "type": "object"
    },
    "CostHotspot": {
      "description": "One row of a hotspot ranking: records at ``medium`` or ``high``, then at ``low``.",
      "properties": {
        "dimension": {
          "enum": [
            "provision",
            "payer",
            "effort_type"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "recurrence": {
          "enum": [
            "one_off",
            "recurring"
          ],
          "title": "Recurrence",
          "type": "string"
        },
        "medium_or_high": {
          "title": "Medium Or High",
          "type": "integer"
        },
        "low": {
          "title": "Low",
          "type": "integer"
        },
        "records": {
          "title": "Records",
          "type": "integer"
        },
        "provision_keys": {
          "items": {
            "type": "string"
          },
          "title": "Provision Keys",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "value",
        "recurrence",
        "medium_or_high",
        "low",
        "records"
      ],
      "title": "CostHotspot",
      "type": "object"
    },
    "CostRecord": {
      "properties": {
        "obligation_id": {
          "title": "Obligation Id",
          "type": "string"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        },
        "provision_key": {
          "title": "Provision Key",
          "type": "string"
        },
        "source_id": {
          "description": "The citable obligation view of the record's provision.",
          "title": "Source Id",
          "type": "string"
        },
        "records_version": {
          "title": "Records Version",
          "type": "string"
        },
        "statement_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Type"
        },
        "status": {
          "enum": [
            "estimated",
            "not_costed",
            "not_estimated"
          ],
          "title": "Status",
          "type": "string"
        },
        "payer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payer"
        },
        "payer_basis": {
          "default": "unknown",
          "enum": [
            "rule_field",
            "rule_table",
            "inferred",
            "unknown"
          ],
          "title": "Payer Basis",
          "type": "string"
        },
        "payer_legal_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a rule-table payer: the provision that names the payer.",
          "title": "Payer Legal Basis"
        },
        "payer_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payer Quote"
        },
        "sector": {
          "anyOf": [
            {
              "enum": [
                "private",
                "public"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "effort_type": {
          "anyOf": [
            {
              "enum": [
                "new_process",
                "documentation",
                "registration",
                "notification",
                "human_oversight",
                "training",
                "assessment"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort Type"
        },
        "secondary_types": {
          "items": {
            "enum": [
              "new_process",
              "documentation",
              "registration",
              "notification",
              "human_oversight",
              "training",
              "assessment"
            ],
            "type": "string"
          },
          "title": "Secondary Types",
          "type": "array"
        },
        "ia_category": {
          "anyOf": [
            {
              "enum": [
                "compliance_cost",
                "administrative_burden",
                "public_enforcement_cost"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ia Category"
        },
        "one_off": {
          "anyOf": [
            {
              "enum": [
                "negligible",
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "One Off"
        },
        "recurring": {
          "anyOf": [
            {
              "enum": [
                "negligible",
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recurring"
        },
        "applies_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies From"
        },
        "date_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Label"
        },
        "date_withheld": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Withheld"
        },
        "unit_delta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Delta"
        },
        "changed_after_proposal": {
          "default": false,
          "title": "Changed After Proposal",
          "type": "boolean"
        },
        "late_added": {
          "default": false,
          "title": "Late Added",
          "type": "boolean"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "obligation_id",
        "unit_id",
        "provision_key",
        "source_id",
        "records_version",
        "status"
      ],
      "title": "CostRecord",
      "type": "object"
    },
    "CostSection": {
      "description": "The dossier's cost section (R4/R5). Never read by the coverage judge or synthesis.",
      "properties": {
        "records": {
          "items": {
            "$ref": "#/$defs/CostRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "hotspots": {
          "items": {
            "$ref": "#/$defs/CostHotspot"
          },
          "title": "Hotspots",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/CostCoverage"
        },
        "late_added": {
          "description": "Obligation ids added after the proposal.",
          "items": {
            "type": "string"
          },
          "title": "Late Added",
          "type": "array"
        },
        "delta_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the change marks compare, when the run has a before.",
          "title": "Delta Basis"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "CostSection",
      "type": "object"
    },
    "Disagreement": {
      "additionalProperties": false,
      "properties": {
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Finding Ids",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "finding_ids",
        "note"
      ],
      "title": "Disagreement",
      "type": "object"
    },
    "DiscardedFinding": {
      "properties": {
        "finding": {
          "$ref": "#/$defs/ImpactFinding"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "finding",
        "reason"
      ],
      "title": "DiscardedFinding",
      "type": "object"
    },
    "DossierImpact": {
      "properties": {
        "impact_id": {
          "title": "Impact Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ImpactFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "merged": {
          "description": "False when synthesis failed and findings are listed as-is.",
          "title": "Merged",
          "type": "boolean"
        }
      },
      "required": [
        "impact_id",
        "summary",
        "findings",
        "merged"
      ],
      "title": "DossierImpact",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExpertFailure": {
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "error_kind": {
          "enum": [
            "auth",
            "rate_limit",
            "timeout",
            "schema_invalid",
            "process_error",
            "no_data_in_scope"
          ],
          "title": "Error Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        }
      },
      "required": [
        "agent",
        "error_kind",
        "message"
      ],
      "title": "ExpertFailure",
      "type": "object"
    },
    "ImpactChain": {
      "additionalProperties": false,
      "properties": {
        "impact_ids": {
          "description": "Causal order, e.g. ['I1','I3'].",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Impact Ids",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "impact_ids",
        "description"
      ],
      "title": "ImpactChain",
      "type": "object"
    },
    "ImpactFinding": {
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "provision_key": {
          "title": "Provision Key",
          "type": "string"
        },
        "affected_actor": {
          "title": "Affected Actor",
          "type": "string"
        },
        "impact": {
          "title": "Impact",
          "type": "string"
        },
        "mechanism": {
          "title": "Mechanism",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "finding_id",
        "agent",
        "provision_key",
        "affected_actor",
        "impact",
        "mechanism",
        "evidence",
        "confidence",
        "provenance"
      ],
      "title": "ImpactFinding",
      "type": "object"
    },
    "LawVersion": {
      "description": "Header metadata: the version of the law a run analyses (its after version).",
      "properties": {
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "source": {
          "description": "CELEX number or URL of the published text.",
          "title": "Source",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "pre_omnibus": {
          "default": false,
          "description": "True for the 2024 text as adopted, which Regulation (EU) 2026/1744 has since amended.",
          "title": "Pre Omnibus",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "version_id",
        "status",
        "source",
        "date"
      ],
      "title": "LawVersion",
      "type": "object"
    },
    "OpenQuestion": {
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "reason": {
          "enum": [
            "evidence_unresolved",
            "synthesis"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "question",
        "reason"
      ],
      "title": "OpenQuestion",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "system_version": {
          "title": "System Version",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "round": {
          "default": 1,
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "agent",
        "system_version",
        "prompt_hash",
        "backend",
        "model"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "degraded",
        "failed",
        "no_changes"
      ],
      "title": "Status",
      "type": "string"
    },
    "system_version": {
      "title": "System Version",
      "type": "string"
    },
    "law_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/LawVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "impacts": {
      "items": {
        "$ref": "#/$defs/DossierImpact"
      },
      "title": "Impacts",
      "type": "array"
    },
    "chains": {
      "items": {
        "$ref": "#/$defs/ImpactChain"
      },
      "title": "Chains",
      "type": "array"
    },
    "disagreements": {
      "items": {
        "$ref": "#/$defs/Disagreement"
      },
      "title": "Disagreements",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/OpenQuestion"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "discarded": {
      "items": {
        "$ref": "#/$defs/DiscardedFinding"
      },
      "title": "Discarded",
      "type": "array"
    },
    "unprocessed": {
      "description": "Supported findings synthesis did not account for.",
      "items": {
        "$ref": "#/$defs/ImpactFinding"
      },
      "title": "Unprocessed",
      "type": "array"
    },
    "failed_experts": {
      "items": {
        "$ref": "#/$defs/ExpertFailure"
      },
      "title": "Failed Experts",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "costs": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Cost records and hotspots (cost-enabled versions only). Never read by synthesis or the coverage judge."
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "status",
    "system_version"
  ],
  "title": "ImpactDossier",
  "type": "object"
}
