# WOMM application tracing (separate from Claude Code's CC_LANGSMITH_* plugin vars)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=womm-dev
LANGSMITH_TRACING=true

# System version config (defaults to system_versions/v0-baseline.yaml)
WOMM_SYSTEM_VERSION=

# Optional until v0.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=
# HOLDOUT_DATABASE_URL is deliberately not in .env: export it only in the shell that runs the
# holdout scripts, so the API never receives it. It must not equal DATABASE_URL.
WOMM_API_TOKEN=
TYPESAFE_API_KEY=   # or JEV_API_KEY
